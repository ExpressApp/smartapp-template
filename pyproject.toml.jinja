# https://python-poetry.org/docs/

[tool.poetry]
name = "{{bot_project_name}}"
version = "0.1.0"
description = "{{bot_short_description}}"
authors = []
package-mode = false


[tool.poetry.dependencies]
python = ">=3.10,<3.14"

pybotx = ">=0.76.3,<1.0.0"
pybotx-smartapp-rpc = ">=0.13.1,<1.0.0"
pybotx-smart-logger = ">=0.12.1,<1.0.0"

fastapi = ">=0.136.3,<1.0.0"
gunicorn = ">=26.0.0,<27.0.0"
uvicorn = { version = ">=0.49.0,<1.0.0", extras = ["standard"] }

loguru = ">=0.7.3,<1.0.0"
mako = ">=1.3.12,<2.0.0"
pydantic = ">=2.13.4,<3.0.0"
pydantic-settings = ">=2.14.1,<3.0.0"

alembic = ">=1.18.4,<2.0.0"
SQLAlchemy = { version = ">=2.0.50,<3.0.0", extras = ["asyncio"] }
greenlet = ">=3.5.1,<4.0.0"
asyncpg = ">=0.31.0,<1.0.0"  # DB backend for application
psycopg2-binary = ">=2.9.11,<3.0.0"  # DB backend for alembic (migration tool)

redis = ">=7.4.0,<8.0.0"
saq = { version = ">=0.26.4,<1.0.0", extras = ["hiredis"] }

[tool.poetry.group.dev.dependencies]
mypy = "2.1.0"
ruff = ">=0.15.15,<1.0.0"

pytest = ">=9.0.3,<10.0.0"
pytest-asyncio = ">=1.4.0,<2.0.0"
pytest-cov = ">=7.1.0,<8.0.0"

asgi-lifespan = ">=2.1.0,<3.0.0"
requests = ">=2.34.2,<3.0.0"
respx = ">=0.23.1,<1.0.0"

markdown = "3.10.2"

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"

[tool.ruff]
line-length = 88
target-version = "py310"
src = ["app", "tests"]
exclude = ["app/db/migrations"]

[tool.ruff.lint]
select = [
    "ASYNC",
    "B",
    "C4",
    "E",
    "F",
    "I",
    "RET",
    "RUF",
    "S",
    "SIM",
    "UP",
]
ignore = [
    # FastAPI and pybotx dependency injection commonly use calls in defaults.
    "B008",
    # Asserts are idiomatic in tests and simple validation helpers.
    "S101",
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S106"]
"app/smartapp/rpc_methods/common.py" = ["S404", "S603"]
